    Mux(a=x[7], b=false, sel=zx, out=xz7);
    Not(in=xz7, out=xn7);
    Mux(a=xz7, b=xn7, sel=nx, out=xf7);

    Mux(a=x[8], b=false, sel=zx, out=xz8);
    Not(in=xz8, out=xn8);
