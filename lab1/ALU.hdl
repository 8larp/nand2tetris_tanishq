CHIP ALU {
    IN
        x[16], y[16],
        zx, nx,
        zy, ny,
        f,
        no;

    OUT
        out[16],
        zr,
        ng;

    PARTS:
    Mux(a=x[0], b=false, sel=zx, out=xz0);
    Not(in=xz0, out=xn0);
