    Mux(a=x[9], b=false, sel=zx, out=xz9);
    Not(in=xz9, out=xn9);
    Mux(a=xz9, b=xn9, sel=nx, out=xf9);

    Mux(a=x[10], b=false, sel=zx, out=xz10);
