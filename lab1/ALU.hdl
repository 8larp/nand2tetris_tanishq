    Not(in=yz14, out=yn14);
    Mux(a=yz14, b=yn14, sel=ny, out=yf14);

    Mux(a=y[15], b=false, sel=zy, out=yz15);
    Not(in=yz15, out=yn15);
    Mux(a=yz15, b=yn15, sel=ny, out=yf15);

    And(a=xf0, b=yf0, out=and0);
    And(a=xf1, b=yf1, out=and1);
    And(a=xf2, b=yf2, out=and2);
    And(a=xf3, b=yf3, out=and3);
    And(a=xf4, b=yf4, out=and4);
