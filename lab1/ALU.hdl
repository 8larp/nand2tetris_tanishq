    And(a=xf13, b=yf13, out=and13);
    And(a=xf14, b=yf14, out=and14);
    And(a=xf15, b=yf15, out=and15);

    HalfAdder(a=xf0, b=yf0, sum=add0, carry=c1);
    FullAdder(a=xf1, b=yf1, c=c1, sum=add1, carry=c2);
    FullAdder(a=xf2, b=yf2, c=c2, sum=add2, carry=c3);
    FullAdder(a=xf3, b=yf3, c=c3, sum=add3, carry=c4);
    FullAdder(a=xf4, b=yf4, c=c4, sum=add4, carry=c5);
    FullAdder(a=xf5, b=yf5, c=c5, sum=add5, carry=c6);
    FullAdder(a=xf6, b=yf6, c=c6, sum=add6, carry=c7);
    FullAdder(a=xf7, b=yf7, c=c7, sum=add7, carry=c8);
    FullAdder(a=xf8, b=yf8, c=c8, sum=add8, carry=c9);
    FullAdder(a=xf9, b=yf9, c=c9, sum=add9, carry=c10);
    FullAdder(a=xf10, b=yf10, c=c10, sum=add10, carry=c11);
    FullAdder(a=xf11, b=yf11, c=c11, sum=add11, carry=c12);
    FullAdder(a=xf12, b=yf12, c=c12, sum=add12, carry=c13);
    FullAdder(a=xf13, b=yf13, c=c13, sum=add13, carry=c14);
    FullAdder(a=xf14, b=yf14, c=c14, sum=add14, carry=c15);
    FullAdder(a=xf15, b=yf15, c=c15, sum=add15, carry=overflow);

    Mux(a=and0, b=add0, sel=f, out=r0);
    Mux(a=and1, b=add1, sel=f, out=r1);
    Mux(a=and2, b=add2, sel=f, out=r2);
    Mux(a=and3, b=add3, sel=f, out=r3);
    Mux(a=and4, b=add4, sel=f, out=r4);
    Mux(a=and5, b=add5, sel=f, out=r5);
    Mux(a=and6, b=add6, sel=f, out=r6);
    Mux(a=and7, b=add7, sel=f, out=r7);
    Mux(a=and8, b=add8, sel=f, out=r8);
    Mux(a=and9, b=add9, sel=f, out=r9);
    Mux(a=and10, b=add10, sel=f, out=r10);
    Mux(a=and11, b=add11, sel=f, out=r11);
    Mux(a=and12, b=add12, sel=f, out=r12);
    Mux(a=and13, b=add13, sel=f, out=r13);
    Mux(a=and14, b=add14, sel=f, out=r14);
    Mux(a=and15, b=add15, sel=f, out=r15);

    Not(in=r0, out=nr0);
    Not(in=r1, out=nr1);
    Not(in=r2, out=nr2);
    Not(in=r3, out=nr3);
    Not(in=r4, out=nr4);
    Not(in=r5, out=nr5);
    Not(in=r6, out=nr6);
    Not(in=r7, out=nr7);
    Not(in=r8, out=nr8);
    Not(in=r9, out=nr9);
    Not(in=r10, out=nr10);
    Not(in=r11, out=nr11);
    Not(in=r12, out=nr12);
    Not(in=r13, out=nr13);
    Not(in=r14, out=nr14);
    Not(in=r15, out=nr15);

    Mux(a=r0, b=nr0, sel=no, out=o0);
    Mux(a=r1, b=nr1, sel=no, out=o1);
    Mux(a=r2, b=nr2, sel=no, out=o2);
    Mux(a=r3, b=nr3, sel=no, out=o3);
    Mux(a=r4, b=nr4, sel=no, out=o4);
    Mux(a=r5, b=nr5, sel=no, out=o5);
    Mux(a=r6, b=nr6, sel=no, out=o6);
    Mux(a=r7, b=nr7, sel=no, out=o7);
    Mux(a=r8, b=nr8, sel=no, out=o8);
    Mux(a=r9, b=nr9, sel=no, out=o9);
    Mux(a=r10, b=nr10, sel=no, out=o10);
    Mux(a=r11, b=nr11, sel=no, out=o11);
    Mux(a=r12, b=nr12, sel=no, out=o12);
    Mux(a=r13, b=nr13, sel=no, out=o13);
    Mux(a=r14, b=nr14, sel=no, out=o14);
    Mux(a=r15, b=nr15, sel=no, out=o15);

    Or(a=o0, b=o1, out=z01);
    Or(a=o2, b=o3, out=z23);
    Or(a=o4, b=o5, out=z45);
    Or(a=o6, b=o7, out=z67);
    Or(a=o8, b=o9, out=z89);
    Or(a=o10, b=o11, out=z1011);
    Or(a=o12, b=o13, out=z1213);
    Or(a=o14, b=o15, out=z1415);

    Or(a=z01, b=z23, out=z0123);
    Or(a=z45, b=z67, out=z4567);
    Or(a=z89, b=z1011, out=z8911);
    Or(a=z1213, b=z1415, out=z1215);

    Or(a=z0123, b=z4567, out=zLow);
    Or(a=z8911, b=z1215, out=zHigh);
    Or(a=zLow, b=zHigh, out=anyOne);
    Not(in=anyOne, out=zr);

    Or(a=o0, b=o0, out=out[0]);
    Or(a=o1, b=o1, out=out[1]);
    Or(a=o2, b=o2, out=out[2]);
    Or(a=o3, b=o3, out=out[3]);
    Or(a=o4, b=o4, out=out[4]);
    Or(a=o5, b=o5, out=out[5]);
    Or(a=o6, b=o6, out=out[6]);
    Or(a=o7, b=o7, out=out[7]);
    Or(a=o8, b=o8, out=out[8]);
    Or(a=o9, b=o9, out=out[9]);
    Or(a=o10, b=o10, out=out[10]);
    Or(a=o11, b=o11, out=out[11]);
    Or(a=o12, b=o12, out=out[12]);
    Or(a=o13, b=o13, out=out[13]);
    Or(a=o14, b=o14, out=out[14]);
    Or(a=o15, b=o15, out=out[15]);

    Or(a=o15, b=o15, out=ng);
}