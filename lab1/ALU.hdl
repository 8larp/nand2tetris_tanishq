    Mux(a=y[10], b=false, sel=zy, out=yz10);
    Not(in=yz10, out=yn10);
    Mux(a=yz10, b=yn10, sel=ny, out=yf10);

    Mux(a=y[11], b=false, sel=zy, out=yz11);
