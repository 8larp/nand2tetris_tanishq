    Mux(a=x[13], b=false, sel=zx, out=xz13);
    Not(in=xz13, out=xn13);
    Mux(a=xz13, b=xn13, sel=nx, out=xf13);

    Mux(a=x[14], b=false, sel=zx, out=xz14);
    Not(in=xz14, out=xn14);
    Mux(a=xz14, b=xn14, sel=nx, out=xf14);

    Mux(a=x[15], b=false, sel=zx, out=xz15);
    Not(in=xz15, out=xn15);
    Mux(a=xz15, b=xn15, sel=nx, out=xf15);

    Mux(a=y[0], b=false, sel=zy, out=yz0);
    Not(in=yz0, out=yn0);
    Mux(a=yz0, b=yn0, sel=ny, out=yf0);

    Mux(a=y[1], b=false, sel=zy, out=yz1);
    Not(in=yz1, out=yn1);
    Mux(a=yz1, b=yn1, sel=ny, out=yf1);

    Mux(a=y[2], b=false, sel=zy, out=yz2);
    Not(in=yz2, out=yn2);
    Mux(a=yz2, b=yn2, sel=ny, out=yf2);

    Mux(a=y[3], b=false, sel=zy, out=yz3);
    Not(in=yz3, out=yn3);
    Mux(a=yz3, b=yn3, sel=ny, out=yf3);

    Mux(a=y[4], b=false, sel=zy, out=yz4);
    Not(in=yz4, out=yn4);
    Mux(a=yz4, b=yn4, sel=ny, out=yf4);

    Mux(a=y[5], b=false, sel=zy, out=yz5);
    Not(in=yz5, out=yn5);
    Mux(a=yz5, b=yn5, sel=ny, out=yf5);

    Mux(a=y[6], b=false, sel=zy, out=yz6);
    Not(in=yz6, out=yn6);
    Mux(a=yz6, b=yn6, sel=ny, out=yf6);

